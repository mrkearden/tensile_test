Header
  CHECK KEYWORDS Warn
  Mesh DB "." "zugmesh"
  Include Path ""
  Results Directory "results"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Scanning
  Steady State Max Iterations = 1
  Output Intervals(4) = 4 16000 8000 9050
  BDF Order = 2
Timestep Intervals(4) = 4 16000 8000 9050
  Timestep Sizes(4) = 0.001 1.E-6 1.E-5 1.E-4
  Solver Input File = case.sif
  Post File = umatcase.vtu
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.67e-08
  Permittivity of Vacuum = 8.8542e-12
  Boltzmann Constant = 1.3807e-23
  Unit Charge = 1.602e-19
End

Body 1
  Target Bodies(1) = 1
  Name = "Body 1"
  Equation = 1
  Material = 1
End

Solver 1
  Equation = Nonlinear elasticity
  Variable = -dofs 3 Displacement
  Calculate Strains = True
  Procedure = "ElasticSolve" "ElasticSolver"
  Calculate Principal = True
  Calculate Stresses = True
  Exec Solver = Always
  Stabilize = True
  Bubbles = False
  Lumped Mass Matrix = False
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-3
  Nonlinear System Max Iterations = 150
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 1
  Linear System Solver = Direct
  Linear System Direct Method = Mumps
  Linear System Iterative Method = GCR
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-7
  BiCGstabl polynomial degree = 2
  Linear System Preconditioning = ILU0
  Linear System ILUT Tolerance = 1.0e-3
  Linear System Abort Not Converged = False
  Linear System Residual Output = 10
  Linear System Precondition Recompute = 1
  
  Output State Variables = Logical True 
  Calculate Loads = Logical True
  Large Displacement = Logical True
  
End

Solver 2
Exec Solver = After Timestep
Equation = SaveScalars
Procedure = "SaveData" "SaveScalars"
Filename = "forces.dat"
 Variable 1 = time
 Variable 2 = Displacement Loads 1
 Operator 2 = boundary sum
End

Equation 1
  Name = "Equation 1"
  Active Solvers(1) = 1
End


Material 1

! fplastic: true stress vs. log TOTAL strain, E = sig1/eps1 = 210000 MPa (mm, MPa)
! eps_i = plastic strain_i + sig_i/210000 ; plateau kept non-softening (fplastic does not allow softening)
  Number of Material Constants = Integer 51
  Number of State Variables = Integer 14
  ! List material constants as {}:
Material Constants(51) = Real 0.3 0.00154761904762	325
0.0053032047619	326.173
0.00905796666667	327.173
0.0128127285714	328.173
0.0165789	331.569
0.0203563095238	337.325
0.0241548238095	347.513
0.027986552381	364.676
0.0317963047619	377.224
0.0407839714286	400.254
0.0497741	423.801
0.0587381380952	441.869
0.0676903238095	457.238
0.0766319761905	470.605
0.0855658857143	482.346
0.0944934	492.744
0.103415614286	502.029
0.112333761905	510.46
0.121249404762	518.155
0.130161285714	525.27
0.139070704762	531.868
0.147977957143	538.011
0.156883390476	543.772
0.165787304762	549.214
0.174690638095	554.324
UMAT Subroutine = File "UMATLib" "fplastic"
!
End


Boundary Condition 1
  Target Boundaries(1) = 3
  Name = "symx"
  Displacement 1 = 0
End

Boundary Condition 2
  Target Boundaries(1) = 4
  Name = "symy"
  Displacement 2 = 0
End

Boundary Condition 3
  Target Boundaries(1) = 5
  Name = "symz"
  Displacement 3 = 0
End

Boundary Condition 4
  Target Boundaries(1) = 2
  Name = "load"
  Displacement 1 = Variable "Time"; Real Matc "tx*14.0"
    Save Scalars = Logical True
  End
